# Application role: least privilege, cannot rewrite the audit log.
DATABASE_URL=postgres://fndn_api:change-me@localhost:5433/fndn
# Owner role: migrations only. Never give this one to the running API.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/fndn
PORT=3000
# Number of proxies you control in front of the API (Caddy: 1). Only those hops are trusted, so a
# client-supplied X-Forwarded-For entry can never choose its rate-limit bucket.
TRUST_PROXY_HOPS=0
COOKIE_SECURE=false
